generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model with Role, Wallet/Store Credit, and relations
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  image     String?
  role      String   @default("customer") // "customer" | "admin"
  wallet    Float    @default(0.0)         // Store credit for instant return refunds (+5% bonus)
  cart      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ratings     Rating[]
  Address     Address[]
  store       Store?
  buyerOrders Order[]   @relation("BuyerRelation")
}

// Product with accurate Stock count & Active status
model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  mrp         Float
  price       Float
  images      String[]
  category    String
  stock       Int      @default(10)          // Numeric inventory count for low-stock badges
  inStock     Boolean  @default(true)
  storeId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  rating     Rating[]
}

// Updated with full lifecycle tracking & return/refund statuses
enum OrderStatus {
  ORDER_PLACED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_PICKED_UP
  RETURN_REJECTED
  REFUNDED
}

// Payment Methods supported across checkout
enum PaymentMethod {
  COD
  STRIPE
  RAZORPAY
  WALLET
}

// Order model with Doorstep Returns & Refund Choices
model Order {
  id            String        @id @default(cuid())
  total         Float
  status        OrderStatus   @default(ORDER_PLACED)
  userId        String
  storeId       String
  addressId     String
  isPaid        Boolean       @default(false)
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  isCouponUsed  Boolean       @default(false)
  coupon        Json          @default("{}")

  // --- Tracking Fields ---
  trackingNumber    String?       // e.g. "TRK-9832104" ya courier AWB
  courierName       String?       // e.g. "Delhivery", "BlueDart", "Shiprocket"
  trackingUrl       String?       // Direct external tracking link
  estimatedDelivery DateTime?     // Expected delivery date

  // --- Return & Refund Center Fields ---
  returnReason      String?       // "Damaged or defective item", "Wrong item delivered", etc.
  returnNotes       String?       // User feedback & inspection details
  refundMethod      String?       // "ORIGINAL" (Razorpay/Card) ya "WALLET" (Store Credit +5%)
  pickupSlot        String?       // "Tomorrow (10:00 AM - 2:00 PM)", etc.
  refundAmount      Float?
  returnedAt        DateTime?

  // Relations
  orderItems OrderItem[]
  timeline   OrderTimeline[]
  user       User          @relation("BuyerRelation", fields: [userId], references: [id])
  store      Store         @relation(fields: [storeId], references: [id])
  address    Address       @relation(fields: [addressId], references: [id])
}

// Step-by-step history log for tracking stepper UI
model OrderTimeline {
  id          String      @id @default(cuid())
  orderId     String
  status      OrderStatus
  title       String      // e.g., "Package Shipped", "Pickup Scheduled"
  description String?     // e.g., "Agent assigned for doorstep inspection"
  location    String?     // e.g., "Bareilly Hub, UP"
  createdAt   DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// Order items mapping
model OrderItem {
  orderId   String
  productId String
  quantity  Int
  price     Float

  // Relations
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@id([orderId, productId])
}

// Product ratings & reviews
model Rating {
  id        String   @id @default(cuid())
  rating    Int
  review    String
  userId    String
  productId String
  orderId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, orderId])
}

// Delivery addresses
model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  email     String
  street    String
  city      String
  state     String
  zip       String
  country   String
  phone     String
  createdAt DateTime @default(now())

  // Relations
  Order Order[]
  user  User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Enhanced Dynamic Coupon Engine
model Coupon {
  code        String    @id
  description String?
  discount    Float     // Percentage discount or flat amount
  type        String    @default("PERCENTAGE") // "PERCENTAGE" | "FLAT"
  minCart     Float     @default(0.0)          // Minimum cart order required
  forNewUser  Boolean   @default(false)
  forMember   Boolean   @default(false)
  isPublic    Boolean   @default(true)
  isActive    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

// Multivendor Store model
model Store {
  id          String   @id @default(cuid())
  userId      String   @unique
  name        String
  description String
  username    String   @unique
  address     String
  status      String   @default("pending")
  isActive    Boolean  @default(false)
  logo        String
  email       String
  contact     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Product Product[]
  Order   Order[]
  user    User     @relation(fields: [userId], references: [id])
}